<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>TodoziSharp</PackageId>
    <Version>0.1.0</Version>
    <Authors>TonTon Bernie</Authors>
    <Description>A .NET wrapper for the Todozi C library - A comprehensive task management system</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/cyber-boost/todozi</RepositoryUrl>
    <PackageTags>task-management productivity todo dotnet wrapper</PackageTags>
  </PropertyGroup>


</Project>
